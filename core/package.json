{
	"name": "core",
	"type": "module",
	"private": true,
	"packageManager": "pnpm@10.27.0",
	"scripts": {
		"dev": "tsx watch src/index.ts",
		"worker:dev": "tsx watch src/worker.ts",
		"worker:finalize:dev": "tsx watch src/worker.ts --role=finalize",
		"worker:general:dev": "tsx watch src/worker.ts --role=general",
		"start": "node dist/index.js",
		"worker": "node dist/worker.js",
		"worker:finalize": "node dist/worker.js --role=finalize",
		"worker:general": "node dist/worker.js --role=general",
		"maintenance": "node dist/maintenance.js",
		"maintenance:dev": "tsx src/maintenance.ts",
		"build": "tsup src/index.ts src/worker.ts src/maintenance.ts --format esm --minify",
		"lint": "pnpm exec biome check src/",
		"format": "pnpm exec biome format src/ --write",
		"db:generate": "pnpm exec prisma generate",
		"db:push": "pnpm exec prisma db push",
		"db:migrate": "pnpm exec prisma migrate dev",
		"db:studio": "pnpm exec prisma studio",
		"db:status": "pnpm exec prisma migrate status",
		"db:reset": "pnpm exec prisma migrate reset --force"
	},
	"devDependencies": {
		"@biomejs/biome": "^1.9.0",
		"@types/cors": "^2.8.17",
		"@types/express": "^5.0.1",
		"@types/node": "^22.15.3",
		"prisma": "^7.1.0",
		"tsup": "^8.0.0",
		"tsx": "^4.19.0",
		"typescript": "^5.9.2"
	},
	"dependencies": {
		"@aws-sdk/client-s3": "^3.1062.0",
		"@aws-sdk/s3-request-presigner": "^3.1062.0",
		"@clerk/backend": "^2.12.3",
		"@prisma/adapter-pg": "^7.1.0",
		"@prisma/client": "^7.1.0",
		"bullmq": "^5.78.1",
		"cors": "^2.8.5",
		"dotenv": "^17.2.2",
		"express": "^5.1.0",
		"express-rate-limit": "^8.6.0",
		"ffmpeg-static": "^5.3.0",
		"ioredis": "^5.10.1",
		"livekit-server-sdk": "^2.15.2",
		"pg": "^8.16.3",
		"rate-limit-redis": "^6.0.0",
		"socket.io": "^4.8.1"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"@biomejs/biome",
			"ffmpeg-static",
			"@prisma/client",
			"@prisma/engines",
			"esbuild",
			"prisma"
		],
		"overrides": {
			"ioredis": "5.10.1"
		}
	}
}
