# Maintenance: one-shot recovery / metering / retention run, then exits.
# Run as a Railway cron service (every 5 min) with `pnpm maintenance`.
DATABASE_URL="postgresql://postgres:password@localhost:5432/my_database"
REDIS_URL="redis://localhost:6379"

NODE_ENV="production"

# Recovered finalize jobs wake the finalize worker.
FINALIZE_WORKER_WAKE_URL="http://finalize-worker.railway.internal:4000"
WORKER_WAKE_SECRET="replace-with-the-same-long-random-secret-as-the-workers"

LIVEKIT_URL="wss://your-livekit-host"
LIVEKIT_API_KEY="your-livekit-api-key"
LIVEKIT_API_SECRET="your-livekit-api-secret"

R2_ACCOUNT_ID="your-cloudflare-account-id"
R2_ACCESS_KEY_ID="your-r2-access-key"
R2_SECRET_ACCESS_KEY="your-r2-secret-key"
R2_BUCKET="openside-recordings"

SELFHOST_ENCRYPTION_KEY="replace-with-32-byte-hex-or-base64-key"
