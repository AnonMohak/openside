DATABASE_URL="postgresql://postgres:password@localhost:5432/my_database"
REDIS_URL="redis://localhost:6379"

WEB_URL="http://localhost:3000"
NODE_ENV="production"

# Each worker's private URL. WORKER_WAKE_URL is the fallback for a single
# worker that consumes every queue.
FINALIZE_WORKER_WAKE_URL="http://finalize-worker.railway.internal:4000"
GENERAL_WORKER_WAKE_URL="http://general-worker.railway.internal:4000"
WORKER_WAKE_SECRET="replace-with-the-same-long-random-secret-as-the-workers"

CLERK_SECRET_KEY="sk_test_xxx"
CLERK_AUTHORIZED_PARTIES="http://localhost:3000"

LIVEKIT_URL="wss://your-livekit-host"
LIVEKIT_API_KEY="your-livekit-api-key"
LIVEKIT_API_SECRET="your-livekit-api-secret"

R2_ACCOUNT_ID="your-cloudflare-account-id"
R2_ACCESS_KEY_ID="your-r2-access-key"
R2_SECRET_ACCESS_KEY="your-r2-secret-key"
R2_BUCKET="openside-recordings"

RESEND_API_KEY="re_your-resend-api-key"
EMAIL_FROM="Openside <invites@openside.pro>"

POLAR_ACCESS_TOKEN="polar_oat_xxx"
POLAR_WEBHOOK_SECRET="whsec_xxx"
POLAR_PRO_PRODUCT_ID="your-pro-product-uuid"
POLAR_SERVER="sandbox"

SELFHOST_ENCRYPTION_KEY="replace-with-32-byte-hex-or-base64-key"