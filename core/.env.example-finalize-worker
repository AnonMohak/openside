# Finalize worker: stitches recordings into final outputs after a session stops.
# Start with `pnpm worker:finalize` (or set WORKER_ROLE on the service).
WORKER_ROLE="finalize"

DATABASE_URL="postgresql://postgres:password@localhost:5432/my_database"
REDIS_URL="redis://localhost:6379"

NODE_ENV="production"

R2_ACCOUNT_ID="your-cloudflare-account-id"
R2_ACCESS_KEY_ID="your-r2-access-key"
R2_SECRET_ACCESS_KEY="your-r2-secret-key"
R2_BUCKET="openside-recordings"
SELFHOST_ENCRYPTION_KEY="replace-with-32-byte-hex-or-base64-key"

WORKER_SERVERLESS="true"
WORKER_WAKE_SECRET="replace-with-the-same-long-random-secret-as-the-api"

# Sized for 8 vCPU / 8 GB: 2 jobs at once, each ffmpeg capped at 4 threads.
WORKER_CONCURRENCY="2"
FFMPEG_THREADS="4"
